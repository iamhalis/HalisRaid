-- FIX: Lấy TẤT CẢ NPC liên quan để phòng trường hợp lỗi ở NPC đầu tiên
local function findAllNPCs(kws)
    local r = {}
    SC(function()
        for _, o in pairs(workspace:GetDescendants()) do
            if o:IsA("Model") then
                local n = string.lower(o.Name)
                for _, k in pairs(kws) do
                    if string.find(n, string.lower(k)) then
                        if o:FindFirstChild("HumanoidRootPart") or o:FindFirstChildWhichIsA("BasePart") then
                            table.insert(r, o)
                            break
                        end
                    end
                end
            end
        end
    end)
    return r
end

-- Combat
local sIdx = 1
local function m1()
    SC(function()
        VirtualUser:CaptureController(); wait(0.01)
        VirtualUser:ClickButton1(Vector2.new())
    end)
end

local function sk(k)
    SC(function()
        VirtualUser:SetKeyDown(Enum.KeyCode[k]); wait(0.05)
        VirtualUser:SetKeyUp(Enum.KeyCode[k])
    end)
end

local function combat()
    while raidActive and phase == "fighting" do
        SC(function()
            local t = findEnemy()
            if t then
                local mh = LP.Character:FindFirstChild("HumanoidRootPart")
                local th = t:FindFirstChild("HumanoidRootPart")
                if mh and th then
                    mh.CFrame = CFrame.new(mh.Position, th.Position)
                    if (mh.Position - th.Position).magnitude > 8 then tpTo(th.Position + Vector3.new(0, 0, 5)) end
                end
                if S.M1 then m1(); wait(S.M1Delay) end
                if #S.Skills > 0 then
                    sk(S.Skills[sIdx])
                    sIdx = sIdx + 1; if sIdx > #S.Skills then sIdx = 1 end
                    wait(S.SkillDelay)
                end
            else
                local hasAw = false
                SC(function()
                    local pg = LP:FindFirstChild("PlayerGui")
                    if pg then
                        for _, o in pairs(pg:GetDescendants()) do
                            if (o:IsA("TextButton") or o:IsA("ImageButton")) and o.Visible then
                                local tx = ""; if o.Text then tx = string.lower(o.Text) end
                                local n = string.lower(o.Name)
                                if string.find(tx, "awaken") or string.find(tx, "click") or string.find(n, "awaken") then hasAw = true; break end
                            end
                        end
                    end
                end)
                if hasAw and S.Awaken then
                    phase = "awakening"
                    setStat("Awakening phase...")
                    notify("Awaken", "Found awaken button!", F.Warn)
                end
                wait(0.5)
            end
        end)
        wait(0.1)
    end
end

-- Awakening
local function doAwaken()
    notify("Awaken", "Looking for awaken UI...", F.Warn)
    local att = 0
    local kw = {}
    if S.SelectedAwaken ~= "Current Fruit" then kw = getKW(S.SelectedAwaken) end
    while raidActive and att < 180 and phase == "awakening" do
        att = att + 1
        SC(function()
            local pg = LP:FindFirstChild("PlayerGui")
            if pg then
                for _, o in pairs(pg:GetDescendants()) do
                    if (o:IsA("TextButton") or o:IsA("ImageButton")) and o.Visible then
                        local tx = ""; if o.Text then tx = string.lower(o.Text) end
                        local n = string.lower(o.Name)
                        if #kw > 0 then
                            for _, k in pairs(kw) do
                                if string.find(tx, k) then
                                    o.MouseButton1Click:Fire()
                                    notify("Awaken", "Clicked: " .. o.Text, F.Ok)
                                    wait(0.5); return
                                end
                            end
                        end
                        if string.find(tx, "awaken") or string.find(tx, "click") or string.find(tx, "yes") or string.find(n, "awaken") then
                            o.MouseButton1Click:Fire()
                            notify("Awaken", "Clicked button", F.Ok); wait(0.5)
                        end
                    end
                end
            end
            for _, o in pairs(workspace:GetDescendants()) do
                if o:IsA("ProximityPrompt") then
                    local at = ""; if o.ActionText then at = string.lower(o.ActionText) end
                    if string.find(at, "awaken") or string.find(at, "click") then
                        o.HoldDuration = 0; o:InputHoldEnd()
                    end
                end
            end
        end)
        wait(0.5)
        if findEnemy() then
            phase = "fighting"; setStat("More enemies - fighting")
            spawn(combat); return
        end
    end
    phase = "done"; raidCount = raidCount + 1
    if countLbl then countLbl.Text = tostring(raidCount) end
    setStat("Raid #" .. raidCount .. " complete!")
    notify("Done", "Raid #" .. raidCount .. " complete!", F.Ok)
    if S.Retry and raidActive then wait(S.Delay); if raidActive then doFullRaid() end end
end

-- FIX: Mua Chip (Có Plan fallback chạy tới NPC Khác)
local function buyChip()
    phase = "buying"
    setStat("Buying " .. S.SelectedChip .. " chip...")
    notify("Chip", "Looking for Raid NPCs...", F.Accent)
    
    -- Ưu tiên tìm Advanced Raid NPC nếu chọn Dough/Phoenix
    local npcKws = {"Scientist", "Mysterious", "Lab"}
    if S.SelectedChip == "Dough" or S.SelectedChip == "Phoenix" then
        npcKws = {"Advanced", "Scientist", "Mysterious"} 
    end

    local npcs = findAllNPCs(npcKws)
    if #npcs > 0 then
        for i, npc in ipairs(npcs) do
            local h = npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChildWhichIsA("BasePart")
            if h then
                setStat("Trying NPC " .. i .. "/" .. #npcs)
                tpTo(h.Position + h.CFrame.LookVector * 5)
                wait(1.5)
                
                -- Tương tác NPC
                SC(function()
                    for _, o in pairs(npc:GetDescendants()) do
                        if o:IsA("ProximityPrompt") then o.HoldDuration = 0; o:InputHoldEnd()
                        elseif o:IsA("ClickDetector") then o.MouseClick:Fire() end
                    end
                end)
                wait(1.5)

                -- Bấm UI
                local chipKws = getKW(S.SelectedChip)
                SC(function()
                    local pg = LP:FindFirstChild("PlayerGui")
                    if pg then
                        for _, o in pairs(pg:GetDescendants()) do
                            if (o:IsA("TextButton") or o:IsA("ImageButton")) and o.Visible then
                                local tx = ""; if o.Text then tx = string.lower(o.Text) end
                                local n = string.lower(o.Name)
                                for _, k in pairs(chipKws) do
                                    if string.find(tx, k) or string.find(n, k) then o.MouseButton1Click:Fire() end
                                end
                            end
                        end
                    end
                end)
                wait(0.5)

                -- Fire Remote để chốt đơn
                local fired = false
                SC(function()
                    for _, o in pairs(RS:GetDescendants()) do
                        if o:IsA("RemoteEvent") or o:IsA("RemoteFunction") then
                            local n = string.lower(o.Name)
                            if string.find(n, "chip") or string.find(n, "buy") or string.find(n, "raid") then
                                if o:IsA("RemoteEvent") then o:FireServer(S.SelectedChip)
                                else o:InvokeServer(S.SelectedChip) end
                                fired = true
                            end
                        end
                    end
                end)
                
                if fired then
                    notify("Chip", "Fired remotes at NPC " .. i, F.Ok)
                    wait(1)
                    -- Sẽ tiếp tục vòng lặp chạy sang NPC khác nếu lệnh mua ở trên bị block/fail
                end
            end
        end
        notify("Chip", "Finished checking NPCs", F.Ok)
    else
        notify("Chip", "No Raid NPC found!", F.Bad)
    end
    wait(1)
end

-- Start Raid
local function startRaid()
    phase = "entering"; setStat("Starting raid...")
    notify("Raid", "Looking for entrance...", F.Accent)
    SC(function()
        for _, o in pairs(RS:GetDescendants()) do
            if o:IsA("RemoteEvent") or o:IsA("RemoteFunction") then
                local n = string.lower(o.Name)
                if string.find(n, "raid") and (string.find(n, "start") or string.find(n, "enter") or string.find(n, "begin")) then
                    if o:IsA("RemoteEvent") then o:FireServer() else o:InvokeServer() end
                    notify("Raid", "Fired: " .. o.Name, F.Ok); return
                end
            end
        end
    end)
    SC(function()
        for _, o in pairs(workspace:GetDescendants()) do
            if o:IsA("BasePart") then
                local n = string.lower(o.Name)
                if string.find(n, "door") or string.find(n, "portal") or string.find(n, "entrance") then
                    local pp = o:FindFirstChildWhichIsA("ProximityPrompt")
                    if pp then pp.HoldDuration = 0; pp:InputHoldEnd(); notify("Raid", "Used door prompt", F.Ok); return end
                    local cd = o:FindFirstChildWhichIsA("ClickDetector")
                    if cd then cd.MouseClick:Fire(); notify("Raid", "Clicked door", F.Ok); return end
                end
            end
            if o:IsA("ProximityPrompt") then
                local at = ""; if o.ActionText then at = string.lower(o.ActionText) end
                if string.find(at, "raid") or string.find(at, "enter") or string.find(at, "start") then
                    o.HoldDuration = 0; o:InputHoldEnd(); notify("Raid", "Used: " .. at, F.Ok); return
                end
            end
        end
    end)
    wait(2)
end

-- Full Raid
function doFullRaid()
    raidActive = true; sIdx = 1
    if S.BuyChip then buyChip() end
    if S.StartRaid then startRaid() end
    if S.DoRaid then
        phase = "fighting"; setStat("Fighting raid enemies...")
        notify("Raid", "Combat started", F.Ok)
        spawn(combat)
        spawn(function()
            while raidActive do
                if phase == "awakening" and S.Awaken then doAwaken()
                elseif phase == "done" then
                    if not S.Retry then raidActive = false end; break
                end
                wait(0.5)
            end
        end)
    end
end

