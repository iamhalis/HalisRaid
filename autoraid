    notify("Awaken", "Target: " .. v, F.Accent)
end)

section("Automation")

toggle("Full Auto Raid", false, function(v)
    S.FullAuto = v; S.BuyChip = v; S.StartRaid = v; S.DoRaid = v
    if v then notify("Full Auto", "Starting! (" .. S.SelectedChip .. ")", F.Ok); setStat("Starting full auto raid..."); spawn(doFullRaid)
    else stopAll() end
end)

