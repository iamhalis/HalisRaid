-- LOGIC 1: FARM RAID (ĐƯỢC VIẾT LẠI HOÀN TOÀN)
-- =========================================
local function combat()
    setNoclip(true) -- Bật xuyên tường
    
    -- Tự động bật Haki (Buso)
    SC(function()
        if not LP.Character:FindFirstChild("HasBuso") then
            local commF = RS:FindFirstChild("Remotes") and RS.Remotes:FindFirstChild("CommF_")
            if commF then commF:InvokeServer("Buso") end
        end
    end)

    while raidActive and phase == "fighting" do
        SC(function()
            local target = findEnemy()
            if target then
                local mh = LP.Character:FindFirstChild("HumanoidRootPart")
                local th = target:FindFirstChild("HumanoidRootPart")
                
                if mh and th then
                    -- Bay lơ lửng TRÊN ĐẦU quái (khoảng cách an toàn) và nhìn chéo xuống
                    local safeHeight = S.Radius > 20 and 20 or S.Radius
                    local topPos = th.Position + Vector3.new(0, safeHeight, 0)
                    
                    if (mh.Position - topPos).Magnitude > 30 then
                        tpTo(topPos)
                    else
                        mh.CFrame = CFrame.new(topPos, th.Position)
                    end
                end
                
                -- Attack
                if S.M1 then m1(); wait(S.M1Delay) end
                if #S.Skills > 0 then
                    sk(S.Skills[sIdx])
                    sIdx = sIdx + 1; if sIdx > #S.Skills then sIdx = 1 end
                    wait(S.SkillDelay)
                end
            else
                -- Không thấy quái -> Tới cửa tiếp theo hoặc Awakening
                local hasAw = false
                SC(function()
                    local pg = LP:FindFirstChild("PlayerGui")
                    if pg then
                        for _, o in pairs(pg:GetDescendants()) do
                            if (o:IsA("TextButton") or o:IsA("ImageButton")) and o.Visible then
                                local tx = ""; if o.Text then tx = string.lower(o.Text) end
                                local n = string.lower(o.Name)
                                if string.find(tx, "awaken") or string.find(tx, "click") or string.find(n, "awaken") then hasAw = true; break end
                            end
                        end
                    end
                end)
                
                if hasAw and S.Awaken then
                    phase = "awakening"
                    setStat("Awakening phase...")
                    notify("Awaken", "Found awaken UI!", F.Warn)
                end
                wait(0.5)
            end
        end)
        wait(0.1)
    end
    setNoclip(false)
end

