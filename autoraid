-- LOGIC 2: BUY CHIP (ĐƯỢC VIẾT LẠI HOÀN TOÀN)
-- =========================================
local function buyChip()
    phase = "buying"
    setStat("Buying " .. S.SelectedChip .. " chip...")
    notify("Chip", "Buying Chip Via Remotes...", F.Accent)
    
    -- CÁCH 1: Sử dụng chuẩn Direct Remote của Blox Fruits (Nhanh, không cần di chuyển)
    local remoteSuccess = SC(function()
        local commF = RS:FindFirstChild("Remotes") and RS.Remotes:FindFirstChild("CommF_")
        if commF then
            -- Mua thông qua remote
            local chipType = S.SelectedChip .. " Microchip"
            local res = commF:InvokeServer("BuyMicrochip", chipType) 
            if not res then res = commF:InvokeServer("RaidsNpc", "Select", S.SelectedChip) end
            
            notify("Chip", "Remote executed!", F.Ok)
            return true
        end
        return false
    end)

    if remoteSuccess then wait(1.5); return end

    -- CÁCH 2: Đi tìm Physical NPC (Fallback nếu game lỡ đổi Remote)
    notify("Chip", "Remote Failed, finding Physical NPC...", F.Warn)
    local npcKws = {"mysterious scientist"}
    if S.SelectedChip == "Dough" or S.SelectedChip == "Phoenix" then npcKws = {"advanced fruit awakener", "mysterious scientist"} end

    local npcs = {}
    for _, o in pairs(workspace:GetDescendants()) do
        if o:IsA("Model") then
            local n = string.lower(o.Name)
            for _, k in pairs(npcKws) do
                if string.find(n, k) and (o:FindFirstChild("HumanoidRootPart") or o:FindFirstChildWhichIsA("BasePart")) then table.insert(npcs, o) end
            end
        end
    end

    if #npcs > 0 then
        local npc = npcs[1]
        local h = npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChildWhichIsA("BasePart")
        if h then
            tpTo(h.Position + h.CFrame.LookVector * 5)
            wait(1.5)
            
            -- Ép mở UI của NPC
            SC(function()
                for _, o in pairs(npc:GetDescendants()) do
                    if o:IsA("ProximityPrompt") then o.HoldDuration = 0; o:InputHoldEnd()
                    elseif o:IsA("ClickDetector") then o.MouseClick:Fire() end
                end
            end)
            wait(1)

            -- Tìm và Click nút
            local chipKws = getKW(S.SelectedChip)
            SC(function()
                local pg = LP:FindFirstChild("PlayerGui")
                if pg then
                    for _, o in pairs(pg:GetDescendants()) do
                        if (o:IsA("TextButton") or o:IsA("ImageButton")) and o.Visible then
                            local tx = ""; if o.Text then tx = string.lower(o.Text) end
                            for _, k in pairs(chipKws) do if string.find(tx, k) then o.MouseButton1Click:Fire() end end
                        end
                    end
                end
            end)
        end
    else
        notify("Chip", "No Raid NPC found in this map!", F.Bad)
    end
    wait(1.5)
end

