local function findNPC(kws)
    local r = nil
    SC(function()
        for _, o in pairs(workspace:GetDescendants()) do
            if o:IsA("Model") then
                local n = string.lower(o.Name)
                for _, k in pairs(kws) do
                    if string.find(n, string.lower(k)) then
                        if o:FindFirstChild("HumanoidRootPart") or o:FindFirstChildWhichIsA("BasePart") then
                            r = o; return
                        end
                    end
                end
            end
        end
    end) return r
end

local function tpTo(pos)
    SC(function()
        local c = LP.Character if not c then return end
        local h = c:FindFirstChild("HumanoidRootPart") if not h then return end
        local d = (h.Position - pos).magnitude
        if d > 300 then h.CFrame = CFrame.new(pos)
        else
            local tw = TweenService:Create(h, TweenInfo.new(math.min(d/80,4),Enum.EasingStyle.Linear),{CFrame=CFrame.new(pos)})
            tw:Play(); tw.Completed:wait()
        end
    end)
end

local function findEnemy()
    local c = LP.Character if not c then return nil end
    local mh = c:FindFirstChild("HumanoidRootPart") if not mh then return nil end
    local cl, cd = nil, S.Radius
    SC(function()
        for _, o in pairs(workspace:GetDescendants()) do
            if o:IsA("Model") then
                local hm = o:FindFirstChildOfClass("Humanoid")
                if hm and hm.Health > 0 and o ~= c then
                    if not Players:GetPlayerFromCharacter(o) then
                        local h = o:FindFirstChild("HumanoidRootPart")
                        if h then
                            local d = (h.Position - mh.Position).magnitude
                            if d < cd then cd = d; cl = o end
                        end
                    end
                end
            end
        end
    end) return cl
end

