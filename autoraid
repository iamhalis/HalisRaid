local function toggle(label, def, cb)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, 0, 0, 40); f.BackgroundColor3 = Color3.fromRGB(38, 38, 38)
    f.BackgroundTransparency = 0.5; f.BorderSizePixel = 0; f.Parent = sc
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 6)
    
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, -52, 1, 0); l.Position = UDim2.new(0, 12, 0, 0)
    l.BackgroundTransparency = 1; l.Text = label; l.TextColor3 = F.Text1
    l.TextSize = 12; l.Font = Enum.Font.Gotham; l.TextXAlignment = Enum.TextXAlignment.Left; l.Parent = f
    
    local pill = Instance.new("TextButton")
    pill.Size = UDim2.new(0, 40, 0, 22); pill.Position = UDim2.new(1, -48, 0.5, -11)
    pill.BackgroundColor3 = F.TogOff; pill.BorderSizePixel = 0; pill.Text = ""; pill.AutoButtonColor = false; pill.Parent = f
    Instance.new("UICorner", pill).CornerRadius = UDim.new(0, 11)
    
    local dot = Instance.new("Frame")
    dot.Size = UDim2.new(0, 16, 0, 16); dot.Position = UDim2.new(0, 2, 0, 3)
    dot.BackgroundColor3 = Color3.fromRGB(160, 160, 160); dot.BorderSizePixel = 0; dot.Parent = pill
    Instance.new("UICorner", dot).CornerRadius = UDim.new(0, 8)
    
    local on = def
    local function up()
        if on then
            TweenService:Create(pill, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {BackgroundColor3 = F.Accent}):Play()
            TweenService:Create(dot, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {Position = UDim2.new(0, 22, 0, 3), BackgroundColor3 = Color3.new(1, 1, 1)}):Play()
        else
            TweenService:Create(pill, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {BackgroundColor3 = F.TogOff}):Play()
            TweenService:Create(dot, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {Position = UDim2.new(0, 2, 0, 3), BackgroundColor3 = Color3.fromRGB(160, 160, 160)}):Play()
        end
    end
    pill.MouseButton1Click:Connect(function() on = not on; up(); if cb then cb(on) end end)
    if def then up() end
end

local function slider(label, mn, mx, df, cb)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, 0, 0, 48); f.BackgroundColor3 = Color3.fromRGB(38, 38, 38)
    f.BackgroundTransparency = 0.5; f.BorderSizePixel = 0; f.Parent = sc
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 6)
    
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, -50, 0, 18); l.Position = UDim2.new(0, 12, 0, 6)
    l.BackgroundTransparency = 1; l.Text = label; l.TextColor3 = F.Text1
    l.TextSize = 11; l.Font = Enum.Font.Gotham; l.TextXAlignment = Enum.TextXAlignment.Left; l.Parent = f
    
    local v = Instance.new("TextLabel")
    v.Size = UDim2.new(0, 36, 0, 18); v.Position = UDim2.new(1, -46, 0, 6)
    v.BackgroundTransparency = 1; v.Text = tostring(df); v.TextColor3 = F.Accent
    v.TextSize = 11; v.Font = Enum.Font.GothamBold; v.TextXAlignment = Enum.TextXAlignment.Right; v.Parent = f
    
    local t = Instance.new("Frame")
    t.Size = UDim2.new(1, -24, 0, 4); t.Position = UDim2.new(0, 12, 0, 34)
    t.BackgroundColor3 = F.Track; t.BorderSizePixel = 0; t.Parent = f
    Instance.new("UICorner", t).CornerRadius = UDim.new(0, 2)
    
    local fl = Instance.new("Frame")
    fl.Size = UDim2.new((df - mn) / (mx - mn), 0, 1, 0); fl.BackgroundColor3 = F.Accent; fl.BorderSizePixel = 0; fl.Parent = t
    Instance.new("UICorner", fl).CornerRadius = UDim.new(0, 2)
    
    local kn = Instance.new("Frame")
    kn.Size = UDim2.new(0, 16, 0, 16); kn.Position = UDim2.new((df - mn) / (mx - mn), -8, 0, -6)
    kn.BackgroundColor3 = F.Text1; kn.BorderSizePixel = 0; kn.Parent = f
    Instance.new("UICorner", kn).CornerRadius = UDim.new(0, 8)
    
    local ring = Instance.new("UIStroke")
    ring.Color = F.Accent; ring.Thickness = 2; ring.Transparency = 1; ring.Parent = kn
    
    local sld = false
    local function upd(inp)
        local rx = math.clamp((inp.Position.X - t.AbsolutePosition.X) / t.AbsoluteSize.X, 0, 1)
        local val = math.floor(mn + rx * (mx - mn))
        fl.Size = UDim2.new(rx, 0, 1, 0); kn.Position = UDim2.new(rx, -8, 0, -6); v.Text = tostring(val)
        if cb then cb(val) end
    end
    
    t.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            sld = true; upd(i); TweenService:Create(ring, TweenInfo.new(0.15), {Transparency = 0.3}):Play()
        end
    end)
    UserInput.InputChanged:Connect(function(i)
        if sld and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then upd(i) end
    end)
    UserInput.InputEnded:Connect(function(i)
        if sld and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
            sld = false; TweenService:Create(ring, TweenInfo.new(0.15), {Transparency = 1}):Play()
        end
    end)
end

local function btn(label, col, cb)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 0, 34); b.BackgroundColor3 = Color3.fromRGB(38, 38, 38)
    b.BackgroundTransparency = 0.5; b.BorderSizePixel = 0; b.Text = ""; b.AutoButtonColor = false; b.Parent = sc
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    
    local accBar = Instance.new("Frame")
    accBar.Size = UDim2.new(0, 3, 0.6, 0); accBar.Position = UDim2.new(0, 6, 0.2, 0)
    accBar.BackgroundColor3 = col or F.Accent; accBar.BorderSizePixel = 0; accBar.Parent = b
    Instance.new("UICorner", accBar).CornerRadius = UDim.new(0, 2)
    
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, -20, 1, 0); l.Position = UDim2.new(0, 16, 0, 0)
    l.BackgroundTransparency = 1; l.Text = label; l.TextColor3 = col or F.Accent
    l.TextSize = 12; l.Font = Enum.Font.GothamBold; l.TextXAlignment = Enum.TextXAlignment.Left; l.Parent = b
    
    b.MouseButton1Click:Connect(function() if cb then cb() end end)
    b.MouseEnter:Connect(function() TweenService:Create(b, TweenInfo.new(0.12), {BackgroundTransparency = 0.2, BackgroundColor3 = Color3.fromRGB(56, 56, 56)}):Play() end)
    b.MouseLeave:Connect(function() TweenService:Create(b, TweenInfo.new(0.12), {BackgroundTransparency = 0.5, BackgroundColor3 = Color3.fromRGB(38, 38, 38)}):Play() end)
end

local clickBlocker = nil
local function dropdown(label, opts, def, cb)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, 0, 0, 40); f.BackgroundColor3 = Color3.fromRGB(38, 38, 38)
    f.BackgroundTransparency = 0.5; f.BorderSizePixel = 0; f.Parent = sc
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 6)

    f.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then TweenService:Create(f, TweenInfo.new(0.12), {BackgroundTransparency = 0.2}):Play() end end)
    f.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then TweenService:Create(f, TweenInfo.new(0.12), {BackgroundTransparency = 0.5}):Play() end end)

    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, -110, 1, 0); l.Position = UDim2.new(0, 12, 0, 0)
    l.BackgroundTransparency = 1; l.Text = label; l.TextColor3 = F.Text1
    l.TextSize = 11; l.Font = Enum.Font.Gotham; l.TextXAlignment = Enum.TextXAlignment.Left; l.TextTruncate = Enum.TextTruncate.AtEnd; l.Parent = f

    local cbBtn = Instance.new("TextButton")
    cbBtn.Size = UDim2.new(0, 100, 0, 28); cbBtn.Position = UDim2.new(1, -108, 0.5, -14)
    cbBtn.BackgroundColor3 = F.Surface; cbBtn.BackgroundTransparency = 0.2; cbBtn.BorderSizePixel = 0; cbBtn.Text = ""; cbBtn.AutoButtonColor = false; cbBtn.Parent = f
    Instance.new("UICorner", cbBtn).CornerRadius = UDim.new(0, 4)

    local cbStroke = Instance.new("UIStroke"); cbStroke.Color = F.Brd; cbStroke.Thickness = 1; cbStroke.Transparency = 0.3; cbStroke.Parent = cbBtn

    local vLbl = Instance.new("TextLabel")
    vLbl.Size = UDim2.new(1, -24, 1, 0); vLbl.Position = UDim2.new(0, 8, 0, 0)
    vLbl.BackgroundTransparency = 1; vLbl.Text = def; vLbl.TextColor3 = F.Text1
    vLbl.TextSize = 10; vLbl.Font = Enum.Font.GothamBold; vLbl.TextXAlignment = Enum.TextXAlignment.Left; vLbl.TextTruncate = Enum.TextTruncate.AtEnd; vLbl.Parent = cbBtn

    local chev = Instance.new("TextLabel")
    chev.Size = UDim2.new(0, 16, 0, 16); chev.Position = UDim2.new(1, -18, 0.5, -8)
    chev.BackgroundTransparency = 1; chev.Text = "\203"; chev.TextColor3 = F.Text3
    chev.TextSize = 7; chev.Font = Enum.Font.GothamBold; chev.Parent = cbBtn

    local optFrame = nil; local isOpen = false

    local function closeDD()
        if optFrame then
            local tempFrame = optFrame
            TweenService:Create(tempFrame, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {BackgroundTransparency = 1}):Play()
            spawn(function() wait(0.15); SC(function() if tempFrame then tempFrame:Destroy() end end) end)
            optFrame = nil
        end
        if clickBlocker then clickBlocker:Destroy(); clickBlocker = nil end
        isOpen = false; if closeCurrentDD == closeDD then closeCurrentDD = nil end
        TweenService:Create(chev, TweenInfo.new(0.15), {Rotation = 0}):Play(); TweenService:Create(cbStroke, TweenInfo.new(0.15), {Color = F.Brd}):Play()
    end

    local function openDDFn()
        if closeCurrentDD and closeCurrentDD ~= closeDD then closeCurrentDD() end
        if isOpen then closeDD(); return end

        isOpen = true; closeCurrentDD = closeDD
        TweenService:Create(chev, TweenInfo.new(0.15), {Rotation = 180}):Play(); TweenService:Create(cbStroke, TweenInfo.new(0.15), {Color = F.Accent}):Play()

        clickBlocker = Instance.new("TextButton")
        clickBlocker.Size = UDim2.new(10, 0, 10, 0); clickBlocker.Position = UDim2.new(-5, 0, -5, 0)
        clickBlocker.BackgroundTransparency = 1; clickBlocker.Text = ""; clickBlocker.ZIndex = 90; clickBlocker.Parent = sg
        clickBlocker.MouseButton1Click:Connect(closeDD)

        local maxH = math.min(#opts * 26 + 8, 200)
        optFrame = Instance.new("Frame")
        optFrame.Size = UDim2.new(0, 270, 0, maxH); optFrame.Position = UDim2.new(0, f.AbsolutePosition.X + 10, 0, f.AbsolutePosition.Y + 45)
        optFrame.BackgroundColor3 = F.Card; optFrame.BorderSizePixel = 0; optFrame.ClipsDescendants = true; optFrame.ZIndex = 100; optFrame.Parent = sg
        Instance.new("UICorner", optFrame).CornerRadius = UDim.new(0, 6)

        local oStroke = Instance.new("UIStroke"); oStroke.Color = F.Brd; oStroke.Thickness = 1; oStroke.Transparency = 0.3; oStroke.Parent = optFrame

        local shd = Instance.new("Frame")
        shd.Size = UDim2.new(1, 4, 1, 4); shd.Position = UDim2.new(0, -2, 0, -2)
        shd.BackgroundColor3 = Color3.fromRGB(0, 0, 0); shd.BackgroundTransparency = 0.6; shd.BorderSizePixel = 0; shd.ZIndex = 99; shd.Parent = optFrame
        Instance.new("UICorner", shd).CornerRadius = UDim.new(0, 8)

        local oSc = Instance.new("ScrollingFrame")
        oSc.Size = UDim2.new(1, -6, 1, -6); oSc.Position = UDim2.new(0, 3, 0, 3)
        oSc.BackgroundTransparency = 1; oSc.ScrollBarThickness = 2; oSc.ScrollBarImageColor3 = F.Brd; oSc.ZIndex = 101
        oSc.CanvasSize = UDim2.new(0, 0, 0, #opts * 26); oSc.Parent = optFrame

        local oLy = Instance.new("UIListLayout"); oLy.SortOrder = Enum.SortOrder.LayoutOrder; oLy.Padding = UDim.new(0, 1); oLy.Parent = oSc

        for _, opt in ipairs(opts) do
            local isSel = (opt == vLbl.Text)
            local oB = Instance.new("TextButton")
            oB.Size = UDim2.new(1, 0, 0, 25); oB.BackgroundColor3 = Color3.fromRGB(56, 56, 56)
            oB.BackgroundTransparency = isSel and 0.4 or 0.8; oB.BorderSizePixel = 0; oB.Text = ""; oB.AutoButtonColor = false; oB.ZIndex = 102; oB.Parent = oSc
            Instance.new("UICorner", oB).CornerRadius = UDim.new(0, 4)

            local oL = Instance.new("TextLabel")
            oL.Size = UDim2.new(1, -12, 1, 0); oL.Position = UDim2.new(0, 8, 0, 0)
            oL.BackgroundTransparency = 1; oL.Text = opt; oL.TextColor3 = isSel and F.Accent or F.Text2
            oL.TextSize = 10; oL.Font = Enum.Font.Gotham; oL.TextXAlignment = Enum.TextXAlignment.Left; oL.TextTruncate = Enum.TextTruncate.AtEnd; oL.ZIndex = 103; oL.Parent = oB

            oB.MouseButton1Click:Connect(function() vLbl.Text = opt; if cb then cb(opt) end; closeDD() end)
            oB.MouseEnter:Connect(function() TweenService:Create(oB, TweenInfo.new(0.1), {BackgroundTransparency = 0.3}):Play() end)
            oB.MouseLeave:Connect(function() TweenService:Create(oB, TweenInfo.new(0.1), {BackgroundTransparency = isSel and 0.4 or 0.8}):Play() end)
        end
    end

    cbBtn.MouseButton1Click:Connect(openDDFn)
    return vLbl
end

