local function slider(label, mn, mx, df, cb)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, 0, 0, 48); f.BackgroundColor3 = Color3.fromRGB(38, 38, 38); f.BackgroundTransparency = 0.5; f.BorderSizePixel = 0; f.Parent = sc
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 6)
    
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, -50, 0, 18); l.Position = UDim2.new(0, 12, 0, 6); l.BackgroundTransparency = 1; l.Text = label; l.TextColor3 = F.Text1
    l.TextSize = 11; l.Font = Enum.Font.Gotham; l.TextXAlignment = Enum.TextXAlignment.Left; l.Parent = f
    
    local v = Instance.new("TextLabel")
    v.Size = UDim2.new(0, 36, 0, 18); v.Position = UDim2.new(1, -46, 0, 6); v.BackgroundTransparency = 1; v.Text = tostring(df); v.TextColor3 = F.Accent
    v.TextSize = 11; v.Font = Enum.Font.GothamBold; v.TextXAlignment = Enum.TextXAlignment.Right; v.Parent = f
    
    local t = Instance.new("Frame")
    t.Size = UDim2.new(1, -24, 0, 4); t.Position = UDim2.new(0, 12, 0, 34); t.BackgroundColor3 = F.Track; t.BorderSizePixel = 0; t.Parent = f
    Instance.new("UICorner", t).CornerRadius = UDim.new(0, 2)
    
    local fl = Instance.new("Frame")
    fl.Size = UDim2.new((df - mn) / (mx - mn), 0, 1, 0); fl.BackgroundColor3 = F.Accent; fl.BorderSizePixel = 0; fl.Parent = t
    Instance.new("UICorner", fl).CornerRadius = UDim.new(0, 2)
    
    local kn = Instance.new("Frame")
    kn.Size = UDim2.new(0, 16, 0, 16); kn.Position = UDim2.new((df - mn) / (mx - mn), -8, 0, -6); kn.BackgroundColor3 = F.Text1; kn.BorderSizePixel = 0; kn.Parent = f
    Instance.new("UICorner", kn).CornerRadius = UDim.new(0, 8)
    
    local ring = Instance.new("UIStroke"); ring.Color = F.Accent; ring.Thickness = 2; ring.Transparency = 1; ring.Parent = kn
    
    local sld = false
    local function upd(inp)
        local rx = math.clamp((inp.Position.X - t.AbsolutePosition.X) / t.AbsoluteSize.X, 0, 1)
        local val = math.floor(mn + rx * (mx - mn))
        fl.Size = UDim2.new(rx, 0, 1, 0); kn.Position = UDim2.new(rx, -8, 0, -6); v.Text = tostring(val)
        if cb then cb(val) end
    end
    
    t.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then sld = true; upd(i); TweenService:Create(ring, TweenInfo.new(0.15), {Transparency = 0.3}):Play() end end)
    UserInput.InputChanged:Connect(function(i) if sld and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then upd(i) end end)
    UserInput.InputEnded:Connect(function(i) if sld and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then sld = false; TweenService:Create(ring, TweenInfo.new(0.15), {Transparency = 1}):Play() end end)
end

