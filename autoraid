local openDD = nil

local function dropdown(label, opts, def, cb)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1,0,0,36); f.BackgroundColor3 = C.BG2; f.BackgroundTransparency = 0.4
    f.BorderSizePixel = 0; f.Parent = sc
    Instance.new("UICorner",f).CornerRadius = UDim.new(0,8)

    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1,-120,1,0); l.Position = UDim2.new(0,10,0,0)
    l.BackgroundTransparency = 1; l.Text = label; l.TextColor3 = C.Txt; l.TextSize = 11
    l.Font = Enum.Font.Gotham; l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextTruncate = Enum.TextTruncate.AtEnd; l.Parent = f

    local bBtn = Instance.new("TextButton")
    bBtn.Size = UDim2.new(0,104,0,26); bBtn.Position = UDim2.new(1,-112,0.5,-13)
    bBtn.BackgroundColor3 = C.BG3; bBtn.BorderSizePixel = 0
    bBtn.Text = ""; bBtn.AutoButtonColor = false; bBtn.Parent = f
    Instance.new("UICorner",bBtn).CornerRadius = UDim.new(0,6)

    local vLbl = Instance.new("TextLabel")
    vLbl.Size = UDim2.new(1,-22,1,0); vLbl.Position = UDim2.new(0,8,0,0)
    vLbl.BackgroundTransparency = 1; vLbl.Text = def; vLbl.TextColor3 = C.Acc
    vLbl.TextSize = 10; vLbl.Font = Enum.Font.GothamBold
    vLbl.TextXAlignment = Enum.TextXAlignment.Left
    vLbl.TextTruncate = Enum.TextTruncate.AtEnd; vLbl.Parent = bBtn

    local arr = Instance.new("TextLabel")
    arr.Size = UDim2.new(0,16,0,16); arr.Position = UDim2.new(1,-18,0.5,-8)
    arr.BackgroundTransparency = 1; arr.Text = "\226\188"; arr.TextColor3 = C.Dim
    arr.TextSize = 8; arr.Font = Enum.Font.GothamBold; arr.Parent = bBtn

    local optFrame = nil
    local isOpen = false

    local function closeDD()
        if optFrame then
            TweenService:Create(optFrame,TweenInfo.new(0.15),{BackgroundTransparency=1}):Play()
            spawn(function() wait(0.15) SC(function() if optFrame then optFrame:Destroy() end end) end)
            optFrame = nil
        end
        isOpen = false
        TweenService:Create(arr,TweenInfo.new(0.15),{Rotation=0}):Play()
    end

    local function openDDFn()
        if openDD and openDD ~= closeDD then
            openDD()
        end
        if isOpen then closeDD(); return end
        isOpen = true
        TweenService:Create(arr,TweenInfo.new(0.15),{Rotation=180}):Play()
        openDD = closeDD

        optFrame = Instance.new("Frame")
        optFrame.Size = UDim2.new(0,266,0,math.min(#opts * 26 + 8, 210))
        optFrame.Position = UDim2.new(0,8,1,2)
        optFrame.BackgroundColor3 = Color3.fromRGB(32,32,48)
        optFrame.BorderSizePixel = 0
        optFrame.ClipsDescendants = true; optFrame.Parent = f
        Instance.new("UICorner",optFrame).CornerRadius = UDim.new(0,6)
        local oStroke = Instance.new("UIStroke")
        oStroke.Color = C.Acc; oStroke.Thickness = 1; oStroke.Transparency = 0.6; oStroke.Parent = optFrame

        local oSc = Instance.new("ScrollingFrame")
        oSc.Size = UDim2.new(1,-6,1,-6); oSc.Position = UDim2.new(0,3,0,3)
        oSc.BackgroundTransparency = 1; oSc.ScrollBarThickness = 2
        oSc.ScrollBarImageColor3 = C.Acc
        oSc.CanvasSize = UDim2.new(0,0,0,#opts * 26)
        oSc.Parent = optFrame
        local oLy = Instance.new("UIListLayout")
        oLy.SortOrder = Enum.SortOrder.LayoutOrder; oLy.Padding = UDim.new(0,1); oLy.Parent = oSc

        for i, opt in ipairs(opts) do
            local oB = Instance.new("TextButton")
            oB.Size = UDim2.new(1,0,0,25); oB.BackgroundColor3 = Color3.fromRGB(38,38,56)
            oB.BackgroundTransparency = 0.6; oB.BorderSizePixel = 0
            oB.Text = ""; oB.AutoButtonColor = false; oB.Parent = oSc
            Instance.new("UICorner",oB).CornerRadius = UDim.new(0,4)
            local oL = Instance.new("TextLabel")
            oL.Size = UDim2.new(1,-12,1,0); oL.Position = UDim2.new(0,8,0,0)
            oL.BackgroundTransparency = 1; oL.Text = opt; oL.TextColor3 = C.Txt
            oL.TextSize = 10; oL.Font = Enum.Font.Gotham
            oL.TextXAlignment = Enum.TextXAlignment.Left
            oL.TextTruncate = Enum.TextTruncate.AtEnd; oL.Parent = oB

            -- Highlight selected
            if opt == def or opt == vLbl.Text then
                oB.BackgroundTransparency = 0.2
                oL.TextColor3 = C.Acc
            end

            oB.MouseButton1Click:Connect(function()
                vLbl.Text = opt
                if cb then cb(opt) end
                closeDD()
            end)
            oB.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch then
                    TweenService:Create(oB,TweenInfo.new(0.1),{BackgroundTransparency=0.1}):Play()
                end
            end)
            oB.InputEnded:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch then
                    if oL.TextColor3 ~= C.Acc then
                        TweenService:Create(oB,TweenInfo.new(0.1),{BackgroundTransparency=0.6}):Play()
                    else
                        TweenService:Create(oB,TweenInfo.new(0.1),{BackgroundTransparency=0.2}):Play()
                    end
                end
            end)
        end
    end

    bBtn.MouseButton1Click:Connect(openDDFn)
    return vLbl
end

