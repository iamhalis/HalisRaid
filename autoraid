-- COMBAT
-- ═══════════════════════════════════════════════════════════════

local sIdx = 1
local function m1() SC(function()
    VirtualUser:CaptureController(); wait(0.01)
    VirtualUser:ClickButton1(Vector2.new())
end) end

local function sk(k) SC(function()
    VirtualUser:SetKeyDown(Enum.KeyCode[k]); wait(0.05)
    VirtualUser:SetKeyUp(Enum.KeyCode[k])
end) end

local function combat()
    while raidActive and phase == "fighting" do
        SC(function()
            local t = findEnemy()
            if t then
                local mh = LP.Character:FindFirstChild("HumanoidRootPart")
                local th = t:FindFirstChild("HumanoidRootPart")
                if mh and th then
                    mh.CFrame = CFrame.new(mh.Position, th.Position)
                    if (mh.Position-th.Position).magnitude > 8 then
                        tpTo(th.Position + Vector3.new(0,0,5))
                    end
                end
                if S.M1 then m1(); wait(S.M1Delay) end
                if #S.Skills > 0 then
                    sk(S.Skills[sIdx])
                    sIdx = sIdx + 1
                    if sIdx > #S.Skills then sIdx = 1 end
                    wait(S.SkillDelay)
                end
            else
                local hasAw = false
                SC(function()
                    local pg = LP:FindFirstChild("PlayerGui")
                    if pg then
                        for _, o in pairs(pg:GetDescendants()) do
                            if (o:IsA("TextButton") or o:IsA("ImageButton")) and o.Visible then
                                local tx = ""; if o.Text then tx = string.lower(o.Text) end
                                local n = string.lower(o.Name)
                                if string.find(tx,"awaken") or string.find(tx,"click") or string.find(n,"awaken") then
                                    hasAw = true; break
                                end
                            end
                        end
                    end
                end)
                if hasAw and S.Awaken then
                    phase = "awakening"
                    setStat("Awakening phase...")
                    notify("Awaken","Found awaken button!",C.Warn)
                end
                wait(0.5)
            end
        end) wait(0.1)
    end
end

-- ═══════════════════════════════════════════════════════════════
-- AWAKENING (with fruit selection)
-- ═══════════════════════════════════════════════════════════════

local function doAwaken()
    notify("Awaken","Looking for awaken UI...",C.Warn)
    local att = 0
    local targetFruit = S.SelectedAwaken
    local keywords = {}
    if targetFruit ~= "Current Fruit" then
        keywords = getChipKeywords(targetFruit)
    end

    while raidActive and att < 180 and phase == "awakening" do
        att = att + 1
        SC(function()
            local pg = LP:FindFirstChild("PlayerGui")
            if pg then
                for _, o in pairs(pg:GetDescendants()) do
                    if (o:IsA("TextButton") or o:IsA("ImageButton")) and o.Visible then
                        local tx = ""; if o.Text then tx = string.lower(o.Text) end
                        local n = string.lower(o.Name)

                        -- If specific fruit selected, try to find that fruit\'s awaken button
                        if #keywords > 0 then
                            for _, kw in pairs(keywords) do
                                if string.find(tx, kw) then
                                    o.MouseButton1Click:Fire()
                                    notify("Awaken","Clicked: " .. o.Text,C.OK)
                                    wait(0.5) return
                                end
                            end
                        end

                        -- Always click generic awaken/click/yes buttons
                        if string.find(tx,"awaken") or string.find(tx,"click") or string.find(tx,"yes") or string.find(n,"awaken") then
                            o.MouseButton1Click:Fire()
                            notify("Awaken","Clicked button",C.OK) wait(0.5)
                        end
                    end
                end
            end
            -- ProximityPrompt
            for _, o in pairs(workspace:GetDescendants()) do
                if o:IsA("ProximityPrompt") then
                    local at = ""; if o.ActionText then at = string.lower(o.ActionText) end
                    if string.find(at,"awaken") or string.find(at,"click") then
                        o.HoldDuration = 0; o:InputHoldEnd()
                    end
                end
            end
        end) wait(0.5)
        if findEnemy() then
            phase = "fighting"; setStat("More enemies - fighting")
            spawn(combat); return
        end
    end
    phase = "done"; raidCount = raidCount + 1
    if countLbl then countLbl.Text = tostring(raidCount) end
    setStat("Raid #" .. raidCount .. " complete!")
    notify("Done","Raid #" .. raidCount .. " complete!",C.OK)
    if S.Retry and raidActive then
        wait(S.Delay)
        if raidActive then doFullRaid() end
    end
end

-- ═══════════════════════════════════════════════════════════════
-- BUY CHIP (with chip selection)
-- ═══════════════════════════════════════════════════════════════

local function buyChip()
    phase = "buying"; setStat("Buying " .. S.SelectedChip .. " chip...")
    notify("Chip","Looking for Mysterious Scientist...",C.Info)
    local npc = findNPC({"Scientist","Mysterious","Lab"})
    if npc then
        local h = npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChildWhichIsA("BasePart")
        if h then
            tpTo(h.Position + h.CFrame.LookVector * 5)
            wait(1)
            -- Try ProximityPrompt first
            SC(function()
                for _, o in pairs(npc:GetDescendants()) do
                    if o:IsA("ProximityPrompt") then
                        o.HoldDuration = 0; o:InputHoldEnd()
                        notify("Chip","Used prompt on NPC",C.OK)
                        wait(1) return
                    end
                end
            end)
            wait(1.5)

            -- Now select the chip from the dialog/GUI
            local chipKws = getChipKeywords(S.SelectedChip)
            notify("Chip","Selecting: " .. S.SelectedChip,C.Info)

            SC(function()
                -- Try PlayerGui for chip selection dialog
                local pg = LP:FindFirstChild("PlayerGui")
                if pg then
                    for _, o in pairs(pg:GetDescendants()) do
                        if (o:IsA("TextButton") or o:IsA("ImageButton")) and o.Visible then
                            local tx = ""; if o.Text then tx = string.lower(o.Text) end
                            local n = string.lower(o.Name)
                            for _, kw in pairs(chipKws) do
                                if string.find(tx, kw) or string.find(n, kw) then
                                    o.MouseButton1Click:Fire()
                                    notify("Chip","Selected chip: " .. o.Text,C.OK)
                                    wait(0.5) return
                                end
                            end
                        end
                    end
                end
            end)
            wait(0.5)

            -- Also try ClickDetector on NPC parts
            SC(function()
                for _, o in pairs(npc:GetDescendants()) do
                    if o:IsA("ClickDetector") then
                        o.MouseClick:Fire()
                        notify("Chip","Clicked detector",C.OK)
                    end
                end
            end)

            -- Try remote
            SC(function()
                for _, o in pairs(RS:GetDescendants()) do
                    if o:IsA("RemoteEvent") or o:IsA("RemoteFunction") then
                        local n = string.lower(o.Name)
                        if string.find(n,"chip") or string.find(n,"buy") or string.find(n,"raid") then
                            if o:IsA("RemoteEvent") then
                                o:FireServer(S.SelectedChip)
                            else
                                o:InvokeServer(S.SelectedChip)
                            end
                            notify("Chip","Fired remote: " .. o.Name,C.OK)
                            wait(1) return
                        end
                    end
                end
            end)
        end
    else
        notify("Chip","NPC not found! Go to lab first",C.Bad)
    end
    wait(1)
end

-- ═══════════════════════════════════════════════════════════════
-- START RAID
-- ═══════════════════════════════════════════════════════════════

local function startRaid()
    phase = "entering"; setStat("Starting raid...")
    notify("Raid","Looking for raid entrance...",C.Info)
    SC(function()
        for _, o in pairs(RS:GetDescendants()) do
            if o:IsA("RemoteEvent") or o:IsA("RemoteFunction") then
                local n = string.lower(o.Name)
                if string.find(n,"raid") and (string.find(n,"start") or string.find(n,"enter") or string.find(n,"begin")) then
                    if o:IsA("RemoteEvent") then o:FireServer()
                    else o:InvokeServer() end
                    notify("Raid","Fired start remote: " .. o.Name,C.OK)
                    return
                end
            end
        end
    end)
    SC(function()
        for _, o in pairs(workspace:GetDescendants()) do
            if o:IsA("BasePart") then
                local n = string.lower(o.Name)
                if string.find(n,"door") or string.find(n,"portal") or string.find(n,"entrance") then
                    local pp = o:FindFirstChildWhichIsA("ProximityPrompt")
                    if pp then pp.HoldDuration = 0; pp:InputHoldEnd()
                        notify("Raid","Used door prompt",C.OK) return end
                    local cd = o:FindFirstChildWhichIsA("ClickDetector")
                    if cd then cd.MouseClick:Fire()
                        notify("Raid","Clicked door",C.OK) return end
                end
            end
            if o:IsA("ProximityPrompt") then
                local at = ""; if o.ActionText then at = string.lower(o.ActionText) end
                if string.find(at,"raid") or string.find(at,"enter") or string.find(at,"start") then
                    o.HoldDuration = 0; o:InputHoldEnd()
                    notify("Raid","Used prompt: " .. at,C.OK) return
                end
            end
        end
    end)
    wait(2)
end

-- ═══════════════════════════════════════════════════════════════
-- FULL RAID SEQUENCE
-- ═══════════════════════════════════════════════════════════════

function doFullRaid()
    raidActive = true; sIdx = 1
    if S.BuyChip then buyChip() end
    if S.StartRaid then startRaid() end
    if S.DoRaid then
        phase = "fighting"; setStat("Fighting raid enemies...")
        notify("Raid","Combat started - M1 + Skills",C.OK)
        spawn(combat)
        spawn(function()
            while raidActive do
                if phase == "awakening" and S.Awaken then
                    doAwaken()
                elseif phase == "done" then
                    if not S.Retry then raidActive = false end
                    break
                end
                wait(0.5)
            end
        end)
    end
end

local function stopAll()
    raidActive = false; phase = "idle"
    setStat("Stopped")
end

