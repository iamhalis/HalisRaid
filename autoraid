-- Helpers & Movement
local function tpTo(pos)
    SC(function()
        local c = LP.Character
        if not c then return end
        local h = c:FindFirstChild("HumanoidRootPart")
        if not h then return end
        local d = (h.Position - pos).magnitude
        if d > 250 then
            h.CFrame = CFrame.new(pos)
        else
            local tw = TweenService:Create(h, TweenInfo.new(d / 150, Enum.EasingStyle.Linear), {CFrame = CFrame.new(pos)})
            tw:Play()
            tw.Completed:wait()
        end
    end)
end

-- Bật/Tắt Noclip chống kẹt tường
local function setNoclip(state)
    if state then
        if not noclipConnection then
            noclipConnection = RunService.Stepped:Connect(function()
                if LP.Character then
                    for _, v in pairs(LP.Character:GetDescendants()) do
                        if v:IsA("BasePart") and v.CanCollide then v.CanCollide = false end
                    end
                end
            end)
        end
    else
        if noclipConnection then noclipConnection:Disconnect(); noclipConnection = nil end
    end
end

-- Tìm quái vật
local function findEnemy()
    local c = LP.Character
    if not c then return nil end
    local mh = c:FindFirstChild("HumanoidRootPart")
    if not mh then return nil end
    local cl, cd = nil, math.huge
    SC(function()
        for _, o in pairs(workspace:GetDescendants()) do
            if o:IsA("Model") and o ~= c and not Players:GetPlayerFromCharacter(o) then
                local hm = o:FindFirstChildOfClass("Humanoid")
                local h = o:FindFirstChild("HumanoidRootPart")
                if hm and h and hm.Health > 0 then
                    local d = (h.Position - mh.Position).magnitude
                    if d < cd then cd = d; cl = o end
                end
            end
        end
    end)
    return cl
end

local function getKW(n)
    local m = {
        ["Flame"]={"flame","mera","fire"}, ["Ice"]={"ice","freeze","hie"}, ["Sand"]={"sand","suna"}, ["Dark"]={"dark","yami"},
        ["Light"]={"light","pika"}, ["Magma"]={"magma","magu"}, ["Quake"]={"quake","gura"}, ["Buddha"]={"buddha"},
        ["String"]={"string","spider","ito"}, ["Rumble"]={"rumble","goro"}, ["Dough"]={"dough","mochi"}, ["Phoenix"]={"phoenix","tori"}
    }
    return m[n] or {string.lower(n)}
end

